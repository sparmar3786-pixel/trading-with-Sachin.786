# Optional production settings. Never commit real values.
APP_ACCESS_TOKEN=change-this-random-long-token
REQUIRE_HTTPS=0
TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Market-memory retention.
TICK_RETENTION_DAYS=7
SNAPSHOT_RETENTION_DAYS=30
TRANSITION_RETENTION_DAYS=365
TICK_QUEUE_MAX=20000
BROKER_SNAPSHOT_INTERVAL_SEC=30
BROKER_TICK_STALE_SEC=60
MAINTENANCE_INTERVAL_SEC=900
